{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Multi-Config (x64)",
      "description": "Run from a Visual Studio developer environment, or use build.ps1, which sets it up.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.22",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "ETHEREAL_WITH_UNIT_TESTS": "OFF",
        "ETHEREAL_BUILD_NV_ASTEROIDS": "OFF",
        "NVRHI_WITH_NVAPI": "ON",
        "NVRHI_WITH_RTXMU": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Ninja Multi-Config (Linux, Vulkan)",
      "description": "No vcpkg needed: GLFW, imgui, stb, cgltf and the Vulkan headers are fetched at configure time. Needs the X11 development packages (libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev) and a Vulkan driver at run time; libgtest-dev adds the nvrhi::core tests.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.22",
        "ETHEREAL_BUILD_SAMPLES": "ON",
        "ETHEREAL_BUILD_BENCHMARKS": "ON",
        "DONUT_WITH_UNIT_TESTS": "ON",
        "NVRHI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 17 2022 (x64)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2022",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.22",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "ETHEREAL_WITH_UNIT_TESTS": "OFF",
        "ETHEREAL_BUILD_NV_ASTEROIDS": "OFF"
      }
    },
    {
      "name": "slang-next",
      "inherits": "default",
      "displayName": "Slang: Windows graphics, CUDA and OptiX",
      "description": "Requires CUDA Toolkit and OPTIX_ROOT pointing to the OptiX SDK. Portable GVDB never invokes NVCC.",
      "cacheVariables": {
        "ETHEREAL_WITH_SLANG": "ON",
        "ETHEREAL_BUILD_SAMPLES": "ON",
        "ETHEREAL_BUILD_GVDB": "ON",
        "ETHEREAL_BUILD_GVDB_LEGACY": "OFF",
        "ETHEREAL_BUILD_BENCHMARKS": "OFF",
        "NVRHI_BUILD_TESTS": "ON",
        "DONUT_WITH_UNIT_TESTS": "ON",
        "SHADERTOOL_BUILD_TESTS": "ON",
        "NVRHI_WITH_CUDA": "ON",
        "NVRHI_WITH_OPTIX": "ON",
        "NVRHI_WITH_NVAPI": "OFF",
        "NVRHI_WITH_RTXMU": "OFF"
      }
    },
    {
      "name": "slang-next-graphics",
      "inherits": "slang-next",
      "displayName": "Slang: Windows graphics only",
      "cacheVariables": {
        "NVRHI_WITH_CUDA": "OFF",
        "NVRHI_WITH_OPTIX": "OFF"
      }
    },
    {
      "name": "slang-next-linux",
      "inherits": "linux",
      "displayName": "Slang: Linux Vulkan, CUDA and OptiX",
      "cacheVariables": {
        "ETHEREAL_WITH_SLANG": "ON",
        "ETHEREAL_BUILD_SAMPLES": "ON",
        "ETHEREAL_BUILD_GVDB": "ON",
        "ETHEREAL_BUILD_GVDB_LEGACY": "OFF",
        "ETHEREAL_BUILD_BENCHMARKS": "OFF",
        "NVRHI_BUILD_TESTS": "ON",
        "DONUT_WITH_UNIT_TESTS": "ON",
        "SHADERTOOL_BUILD_TESTS": "ON",
        "NVRHI_WITH_CUDA": "ON",
        "NVRHI_WITH_OPTIX": "ON",
        "NVRHI_WITH_NVAPI": "OFF",
        "NVRHI_WITH_RTXMU": "OFF"
      }
    },
    {
      "name": "slang-next-linux-graphics",
      "inherits": "slang-next-linux",
      "displayName": "Slang: Linux Vulkan only",
      "cacheVariables": {
        "NVRHI_WITH_CUDA": "OFF",
        "NVRHI_WITH_OPTIX": "OFF"
      }
    }
  ],
