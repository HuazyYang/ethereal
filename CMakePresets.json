{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Multi-Config (x64)",
      "description": "Run from a Visual Studio developer environment, or use build.ps1, which sets it up.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.22",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "ETHEREAL_WITH_UNIT_TESTS": "OFF",
        "ETHEREAL_BUILD_NV_ASTEROIDS" : "OFF",
        "NVRHI_WITH_NVAPI": "ON",
        "NVRHI_WITH_RTXMU": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 17 2022 (x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2022",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.22",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "ETHEREAL_WITH_UNIT_TESTS": "OFF",
        "ETHEREAL_BUILD_NV_ASTEROIDS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "configurePreset": "default", "configuration": "Release" },
    { "name": "relwithdebinfo", "configurePreset": "default", "configuration": "RelWithDebInfo" },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
